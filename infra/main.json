{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "16094266413815275489"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "email-assistant",
      "metadata": {
        "description": "Short prefix used in generated resource names. Use lowercase letters, numbers, and hyphens."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the current resource group location."
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Full container image reference, for example myregistry.azurecr.io/email-assistant:latest."
      }
    },
    "containerRegistryName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Existing Azure Container Registry name in the same resource group. Leave empty when using a public image or an image from another registry already configured for pull access."
      }
    },
    "ingressExternal": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "External ingress toggle. Keep true for a public HTTP API."
      }
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 8000,
      "metadata": {
        "description": "Port the application listens on inside the container. The current FastAPI app uses 8000."
      }
    },
    "ingressTransport": {
      "type": "string",
      "defaultValue": "auto",
      "allowedValues": [
        "auto",
        "http",
        "http2",
        "tcp"
      ],
      "metadata": {
        "description": "Ingress transport protocol for the container app."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum replicas. Use 1 for low-latency interactive APIs; set to 0 for lower dev cost with cold starts."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "metadata": {
        "description": "Maximum replicas for the container app."
      }
    },
    "httpConcurrentRequests": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Approximate concurrent HTTP requests per replica before scaling out."
      }
    },
    "cpuCores": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Container CPU cores."
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "2Gi",
      "metadata": {
        "description": "Container memory allocation."
      }
    },
    "logRetentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Log Analytics retention in days."
      }
    },
    "zoneRedundant": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether the Container Apps managed environment should be zone redundant."
      }
    },
    "environmentPublicNetworkAccess": {
      "type": "string",
      "defaultValue": "Enabled",
      "metadata": {
        "description": "Whether the managed environment allows public network access."
      }
    },
    "enableNetworkLayer": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy a customer-managed virtual network layer for the Container Apps environment."
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Virtual network name used by the Container Apps environment when the network layer is enabled."
      }
    },
    "virtualNetworkAddressPrefix": {
      "type": "string",
      "defaultValue": "10.40.0.0/23",
      "metadata": {
        "description": "Address space for the virtual network. Use a private CIDR that does not overlap with connected networks."
      }
    },
    "infrastructureSubnetName": {
      "type": "string",
      "defaultValue": "aca-infra",
      "metadata": {
        "description": "Delegated infrastructure subnet name for Azure Container Apps."
      }
    },
    "infrastructureSubnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.40.0.0/27",
      "metadata": {
        "description": "Address prefix for the delegated infrastructure subnet. A workload profiles environment supports /27 or larger."
      }
    },
    "networkSecurityGroupName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Network security group name for the delegated Container Apps subnet when the network layer is enabled."
      }
    },
    "internalManagedEnvironment": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Set true to create an internal-only Container Apps environment load balancer. When enabled, also set environmentPublicNetworkAccess to Disabled and consider setting ingressExternal to false."
      }
    },
    "azureAiProjectEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure AI project endpoint used by the app."
      }
    },
    "azureAiAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure AI Foundry account name that owns the target project. When set together with azureAiProjectName, the container app managed identity receives the Azure AI User role at the project scope."
      }
    },
    "azureAiProjectName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure AI Foundry project name used by the app. Leave empty to skip project-level RBAC assignment."
      }
    },
    "openAiAccountName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Azure OpenAI or Azure AI Services account name for direct account-scope inference. When set, the container app managed identity receives the Cognitive Services OpenAI User role at that scope."
      }
    },
    "openAiChatModel": {
      "type": "string",
      "defaultValue": "gpt-4o-mini",
      "metadata": {
        "description": "Primary chat model name used by the app."
      }
    },
    "deepseekChatModel": {
      "type": "string",
      "defaultValue": "DeepSeek-R1",
      "metadata": {
        "description": "Secondary reasoning model name used by the app."
      }
    },
    "knowledgeBaseAgentName": {
      "type": "string",
      "defaultValue": "knowledge-base",
      "metadata": {
        "description": "Azure AI agent name for knowledge base lookup."
      }
    },
    "knowledgeBaseAgentVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Azure AI agent version for knowledge base lookup."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional tags applied to all created resources."
      }
    }
  },
  "variables": {
    "sanitizedPrefix": "[toLower(replace(parameters('namePrefix'), ' ', '-'))]",
    "suffix": "[uniqueString(resourceGroup().id, variables('sanitizedPrefix'), parameters('location'))]",
    "containerAppName": "[take(format('ca-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 32)]",
    "environmentName": "[take(format('cae-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 40)]",
    "logAnalyticsWorkspaceName": "[take(format('law-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 63)]",
    "userAssignedIdentityName": "[take(format('id-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 128)]",
    "resolvedVirtualNetworkName": "[if(not(empty(parameters('virtualNetworkName'))), parameters('virtualNetworkName'), take(format('vnet-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 64))]",
    "resolvedNetworkSecurityGroupName": "[if(not(empty(parameters('networkSecurityGroupName'))), parameters('networkSecurityGroupName'), take(format('nsg-{0}-{1}', variables('sanitizedPrefix'), variables('suffix')), 80))]",
    "useAcr": "[not(empty(parameters('containerRegistryName')))]",
    "useNetworkLayer": "[parameters('enableNetworkLayer')]",
    "assignAzureAiProjectRole": "[and(not(empty(parameters('azureAiAccountName'))), not(empty(parameters('azureAiProjectName'))))]",
    "assignOpenAiAccountRole": "[not(empty(parameters('openAiAccountName')))]",
    "managedEnvironmentNetworkProperties": "[if(variables('useNetworkLayer'), createObject('workloadProfiles', createArray(createObject('name', 'Consumption', 'workloadProfileType', 'Consumption')), 'vnetConfiguration', union(createObject('infrastructureSubnetId', resourceId('Microsoft.Network/virtualNetworks/subnets', variables('resolvedVirtualNetworkName'), parameters('infrastructureSubnetName'))), if(parameters('internalManagedEnvironment'), createObject('internal', true()), createObject()))), createObject())]",
    "commonTags": "[union(parameters('tags'), createObject('workload', 'email-assistant', 'hosting', 'azure-container-apps', 'managedBy', 'bicep'))]",
    "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
    "azureAiUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '53ca6127-db72-4b80-b1b0-d745d6d5456d')]",
    "cognitiveServicesOpenAiUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd')]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2025-07-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "retentionInDays": "[parameters('logRetentionInDays')]",
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "[variables('userAssignedIdentityName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]"
    },
    {
      "condition": "[variables('useNetworkLayer')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-07-01",
      "name": "[variables('resolvedNetworkSecurityGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]"
    },
    {
      "condition": "[variables('useNetworkLayer')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-07-01",
      "name": "[variables('resolvedVirtualNetworkName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('virtualNetworkAddressPrefix')]"
          ]
        }
      }
    },
    {
      "condition": "[variables('useNetworkLayer')]",
      "type": "Microsoft.Network/virtualNetworks/subnets",
      "apiVersion": "2024-07-01",
      "name": "[format('{0}/{1}', variables('resolvedVirtualNetworkName'), parameters('infrastructureSubnetName'))]",
      "properties": {
        "addressPrefix": "[parameters('infrastructureSubnetAddressPrefix')]",
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('resolvedNetworkSecurityGroupName'))]"
        },
        "delegations": [
          {
            "name": "aca-environment-delegation",
            "properties": {
              "serviceName": "Microsoft.App/environments"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('resolvedNetworkSecurityGroupName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('resolvedVirtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('environmentName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "properties": "[union(createObject('publicNetworkAccess', parameters('environmentPublicNetworkAccess'), 'zoneRedundant', parameters('zoneRedundant'), 'appLogsConfiguration', createObject('destination', 'log-analytics', 'logAnalyticsConfiguration', createObject('customerId', reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName')), '2025-07-01').customerId, 'sharedKey', listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName')), '2025-07-01').primarySharedKey))), variables('managedEnvironmentNetworkProperties'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('resolvedVirtualNetworkName'), parameters('infrastructureSubnetName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "condition": "[variables('useAcr')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('containerRegistryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), 'acrpull')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName'))]"
      ]
    },
    {
      "condition": "[variables('assignAzureAiProjectRole')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('azureAiAccountName'), parameters('azureAiProjectName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('azureAiAccountName'), parameters('azureAiProjectName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), 'azure-ai-user')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('azureAiUserRoleDefinitionId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName'))]"
      ]
    },
    {
      "condition": "[variables('assignOpenAiAccountRole')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAiAccountName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), 'openai-user')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('cognitiveServicesOpenAiUserRoleDefinitionId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('commonTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "maxInactiveRevisions": 2,
          "ingress": {
            "external": "[parameters('ingressExternal')]",
            "allowInsecure": false,
            "targetPort": "[parameters('targetPort')]",
            "transport": "[parameters('ingressTransport')]",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "registries": "[if(variables('useAcr'), createArray(createObject('server', format('{0}.azurecr.io', parameters('containerRegistryName')), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "email-assistant",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').clientId]"
                },
                {
                  "name": "AZURE_AI_PROJECT_ENDPOINT",
                  "value": "[parameters('azureAiProjectEndpoint')]"
                },
                {
                  "name": "OPENAI_CHAT_MODEL",
                  "value": "[parameters('openAiChatModel')]"
                },
                {
                  "name": "DEEPSEEK_CHAT_MODEL",
                  "value": "[parameters('deepseekChatModel')]"
                },
                {
                  "name": "KNOWLEDGE_BASE_AGENT_NAME",
                  "value": "[parameters('knowledgeBaseAgentName')]"
                },
                {
                  "name": "KNOWLEDGE_BASE_AGENT_VERSION",
                  "value": "[parameters('knowledgeBaseAgentVersion')]"
                },
                {
                  "name": "PORT",
                  "value": "[string(parameters('targetPort'))]"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('targetPort')]"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 12
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('targetPort')]"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('targetPort')]"
                  },
                  "initialDelaySeconds": 20,
                  "periodSeconds": 20,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ],
              "resources": {
                "cpu": "[parameters('cpuCores')]",
                "memory": "[parameters('memory')]"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-scale",
                "http": {
                  "metadata": {
                    "concurrentRequests": "[string(parameters('httpConcurrentRequests'))]"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[variables('containerAppName')]"
    },
    "containerAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').latestRevisionFqdn)]"
    },
    "managedEnvironmentName": {
      "type": "string",
      "value": "[variables('environmentName')]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').clientId]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('userAssignedIdentityName')), '2024-11-30').principalId]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('logAnalyticsWorkspaceName')]"
    },
    "azureAiProjectRoleAssigned": {
      "type": "bool",
      "value": "[variables('assignAzureAiProjectRole')]"
    },
    "openAiAccountRoleAssigned": {
      "type": "bool",
      "value": "[variables('assignOpenAiAccountRole')]"
    },
    "virtualNetworkName": {
      "type": "string",
      "value": "[if(variables('useNetworkLayer'), variables('resolvedVirtualNetworkName'), '')]"
    },
    "infrastructureSubnetId": {
      "type": "string",
      "value": "[if(variables('useNetworkLayer'), resourceId('Microsoft.Network/virtualNetworks/subnets', variables('resolvedVirtualNetworkName'), parameters('infrastructureSubnetName')), '')]"
    },
    "networkSecurityGroupId": {
      "type": "string",
      "value": "[if(variables('useNetworkLayer'), resourceId('Microsoft.Network/networkSecurityGroups', variables('resolvedNetworkSecurityGroupName')), '')]"
    }
  }
}