{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Azure: Validate",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/infra/deploy.ps1",
        "-ResourceGroup",
        "rg-sandbox",
        "-Action",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Azure: What-If",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/infra/deploy.ps1",
        "-ResourceGroup",
        "rg-sandbox",
        "-Action",
        "what-if"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Azure: Deploy",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/infra/deploy.ps1",
        "-ResourceGroup",
        "rg-sandbox",
        "-Action",
        "deploy"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}